{
  "name": "fill-matic",
  "description": "FillMatic autofills forms with dummy data in one click, saving developers time and making testing faster and easier.",
  "version": "0.0.10",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:extension": "pnpm --filter extension build",
    "postbuild": "bestzip deploy/${npm_package_name}-v${npm_package_version}.zip apps/extension/build/*",
    "dev": "turbo dev",
    "dev:extension": "pnpm --filter extension dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "bestzip": "^3.0.1",
    "prettier": "^3.9.4",
    "turbo": "^2.10.4",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  }
}
