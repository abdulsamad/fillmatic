{
  "name": "fill-matic",
  "description": "FillMatic autofills forms with dummy data in one click, saving developers time and making testing faster and easier.",
  "version": "0.0.4",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "postbuild": "bestzip deploy/${npm_package_name}-v${npm_package_version}.zip apps/extension/build/*",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "bestzip": "^2.2.1",
    "prettier": "^3.2.5",
    "turbo": "^2.1.3",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18"
  }
}
