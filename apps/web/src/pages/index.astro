---
import Layout from "../layouts/Layout.astro";
import {
  CHROME_WEB_STORE_URL,
  PRODUCT_NAME,
  SUPPORT_EMAIL,
} from "@fillmatic/config";

const STORE_URL = CHROME_WEB_STORE_URL;
---

<Layout title={`${PRODUCT_NAME}: Autofill forms for developers`}>
  <div class="site">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Header -->
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo">
          <img src="icon192.png" alt="FillMatic" width="26" height="26" />
          <span>Fill<span class="logo-em">Matic</span></span>
        </a>
        <nav class="header-nav" aria-label="Main">
          <a href="#features">Features</a>
          <a href="#any-input">Any input</a>
          <a href="#ai-mapping">AI mapping</a>
          <a href="#how-it-works">How it works</a>
          <a href="#feedback">Feedback</a>
          <a href={STORE_URL} target="_blank" rel="noopener" class="btn btn-sm"
            >Add to Chrome</a
          >
        </nav>
      </div>
    </header>

    <main id="main-content">
      <!-- Hero -->
      <section class="hero">
        <div class="hero-inner">
          <div class="badge">Chrome Extension, free forever</div>
          <h1>
            Stop filling test forms<br /><span class="gradient-text"
              >by hand</span
            >
          </h1>
          <p>
            FillMatic reads every field on a page and fills it with the right
            kind of data instantly. Built for developers who test the same forms
            day after day.
          </p>
          <div class="hero-actions">
            <a
              href={STORE_URL}
              target="_blank"
              rel="noopener"
              class="btn btn-primary btn-lg"
            >
              Add to Chrome
              <svg
                aria-hidden="true"
                focusable="false"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
              >
            </a>
            <a href="/demo" class="btn btn-ghost btn-lg">Try the demo</a>
          </div>
          <p class="hero-footnote">
            No account needed <span aria-hidden="true">&nbsp;·&nbsp;</span> Works
            on any input, any framework <span aria-hidden="true"
              >&nbsp;·&nbsp;</span
            > Manifest V3
          </p>
        </div>
      </section>

      <!-- Works with strip -->
      <section class="strip">
        <p class="strip-label">Works great with</p>
        <div class="strip-items">
          {
            [
              { name: "Stripe", sub: "test cards" },
              { name: "Lemon Squeezy", sub: "checkout" },
              { name: "Paddle", sub: "billing" },
              { name: "React", sub: "controlled inputs" },
              { name: "Vue", sub: "v-model fields" },
              { name: "Angular", sub: "reactive forms" },
              { name: "Radix / shadcn", sub: "custom widgets" },
              { name: "Rich text editors", sub: "Lexical, ProseMirror, Quill" },
            ].map(({ name, sub }) => (
              <div class="strip-item">
                <span class="strip-name">{name}</span>
                <span class="strip-sub">{sub}</span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Core Features -->
      <section id="features" class="section scroll-mt">
        <div class="section-inner">
          <div class="section-head">
            <div class="badge">Core autofill</div>
            <h2>Fills the right data, every time</h2>
            <p>
              It reads autocomplete attributes, name, id, placeholder, and label
              text to figure out what each field actually wants. No random
              strings in email fields, no text where a number belongs.
            </p>
          </div>
          <div class="card-grid four-col">
            {
              [
                {
                  icon: `<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>`,
                  title: "Smart field detection",
                  desc: "Reads autocomplete attributes, aria labels, name, id, placeholder, and label text to figure out what each field expects.",
                },
                {
                  icon: `<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`,
                  title: "Realistic fake data",
                  desc: "Generates proper names, emails, phone numbers, addresses, card numbers. Looks real enough to pass validation.",
                },
                {
                  icon: `<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M8 10h.01M12 10h.01M16 10h.01M8 14h8"/></svg>`,
                  title: "Natural typing",
                  desc: "Fires the right sequence of events at configurable speed so React, Vue, and Angular all pick up the changes correctly.",
                },
                {
                  icon: `<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
                  title: "Framework-safe",
                  desc: "Works with controlled inputs. It sets values the way the framework expects, so your onChange handlers fire and the UI stays in sync.",
                },
              ].map(({ icon, title, desc }) => (
                <div class="glass-card">
                  <div class="card-icon" set:html={icon} />
                  <h3>{title}</h3>
                  <p>{desc}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Any input, any framework -->
      <section id="any-input" class="section section-tinted scroll-mt">
        <div class="section-inner">
          <div class="section-head">
            <div class="badge">Framework-agnostic</div>
            <h2>If a person can click it, FillMatic can fill it</h2>
            <p>
              Comboboxes, date pickers, toggles, and custom dropdowns built with
              Radix, MUI, or your own code fill correctly out of the box.
              Anything left over, you teach it once with a short recipe.
            </p>
          </div>
          <div class="any-input-grid">
            <div class="glass-card">
              <div class="card-icon">
                <svg
                  aria-hidden="true"
                  focusable="false"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  ><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect
                    x="14"
                    y="3"
                    width="7"
                    height="7"
                    rx="1.5"></rect><rect
                    x="3"
                    y="14"
                    width="7"
                    height="7"
                    rx="1.5"></rect><rect
                    x="14"
                    y="14"
                    width="7"
                    height="7"
                    rx="1.5"></rect></svg
                >
              </div>
              <h3>Works without any setup</h3>
              <p>
                Built-in support for the interaction patterns every component
                library follows, no matter which one your app uses.
              </p>
              <div class="feature-list">
                {
                  [
                    "Dropdowns, comboboxes & autocomplete",
                    "Date and time pickers",
                    "Toggles, switches & radio groups",
                    "Sliders and steppers",
                    "Rich text editors — Notion-style, Lexical, ProseMirror, Quill",
                  ].map((item) => (
                    <div class="feature-check-item">
                      <svg
                        aria-hidden="true"
                        focusable="false"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path d="M20 6L9 17l-5-5" />
                      </svg>
                      <span>{item}</span>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="glass-card">
              <div class="card-icon">
                <svg
                  aria-hidden="true"
                  focusable="false"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  ><circle cx="12" cy="12" r="8"></circle><path
                    d="M12 2v4M12 18v4M2 12h4M18 12h4"></path></svg
                >
              </div>
              <h3>Teach it the one that isn't</h3>
              <p>
                Add a <strong>recipe</strong> in the extension's options: a CSS selector
                for the widget and a few steps — click the trigger, wait for the popover,
                pick an option. It fires on every fill from then on, and always wins
                over the built-in support.
              </p>
              <div class="recipe-flow" aria-hidden="true">
                <span class="recipe-step">click trigger</span>
                <span class="recipe-arrow">→</span>
                <span class="recipe-step">wait for popover</span>
                <span class="recipe-arrow">→</span>
                <span class="recipe-step">click random day</span>
              </div>
              <p class="hint-text">
                A recipe is just a CSS selector and a few steps — save it,
                export it, share it with your team.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Power Features -->
      <section class="section">
        <div class="section-inner">
          <div class="section-head">
            <div class="badge">Power features</div>
            <h2>Built for serious form testing</h2>
            <p>
              Profiles, Actions, and Field Rules let you control exactly what
              gets filled, down to individual fields on specific sites.
            </p>
          </div>
          <div class="power-grid">
            <!-- Actions big card -->
            <div class="glass-card power-card-large">
              <div class="card-icon">
                <svg
                  aria-hidden="true"
                  focusable="false"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  ><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg
                >
              </div>
              <h3>Custom Actions</h3>
              <p>
                One-click buttons that show up in the popup on matching URLs.
                Each action runs a full autofill and overrides specific fields
                with values you set, or a sequence of steps you define.
              </p>
              <div class="action-list">
                {
                  [
                    {
                      name: "Stripe",
                      desc: "Fill test card 4242 4242 4242 4242",
                    },
                    {
                      name: "Lemon Squeezy",
                      desc: "Use test card on Lemon checkout",
                    },
                    {
                      name: "Paddle",
                      desc: "Sandbox billing with valid test data",
                    },
                    { name: "Any site", desc: "Any URL pattern you define" },
                  ].map(({ name, desc }) => (
                    <div class="action-item">
                      <svg
                        aria-hidden="true"
                        focusable="false"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path d="M20 6L9 17l-5-5" />
                      </svg>
                      <div>
                        <strong>{name}</strong>
                        <span>{desc}</span>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>

            <!-- Profiles -->
            <div class="glass-card">
              <div class="card-icon">
                <svg
                  aria-hidden="true"
                  focusable="false"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  ><circle cx="12" cy="8" r="4"></circle><path
                    d="M4 20c0-4 3.6-7 8-7s8 3 8 7"></path></svg
                >
              </div>
              <h3>Identity Profiles</h3>
              <p>
                Switch between Work, Personal, and Staging profiles with one
                click. Each carries its own email domain, password, and field
                overrides.
              </p>
              <div class="tag-row">
                {
                  ["Work", "Personal", "Staging", "+ your own"].map((t) => (
                    <span class="tag">{t}</span>
                  ))
                }
              </div>
            </div>

            <!-- Field Rules -->
            <div class="glass-card">
              <div class="card-icon">
                <svg
                  aria-hidden="true"
                  focusable="false"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  ><path d="M4 6h16M4 10h16M4 14h10M4 18h6"></path></svg
                >
              </div>
              <h3>Field Rules</h3>
              <p>
                Match any field by id, name, placeholder, label, or autocomplete
                using exact, contains, or regex. Whatever you pin always wins.
              </p>
              <div class="code-snippet">
                <span class="c-attr">name</span> contains <span class="c-val"
                  >"coupon"</span
                >
                <span class="c-arrow">→</span> SAVE20
              </div>
            </div>

            <!-- Deep config -->
            <div class="glass-card">
              <div class="card-icon">
                <svg
                  aria-hidden="true"
                  focusable="false"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  ><path d="M12 20h9"></path><path
                    d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                  ></path></svg
                >
              </div>
              <h3>Deep customization</h3>
              <p>
                Typing speed, temp email provider (Mailinator, YOPmail,
                mailsac), ignored fields, shared passwords, always-checked
                boxes. All configurable per profile.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- AI field mapping -->
      <section id="ai-mapping" class="section section-tinted scroll-mt">
        <div class="section-inner">
          <div class="section-head">
            <div class="badge">New · On-device AI</div>
            <h2>Point it at a form. It figures out the rest.</h2>
            <p>
              Open the side panel and scan any page. FillMatic reads every field
              and prefills a map with its own heuristics — then, on machines
              that support Chrome's built-in model, refines it further. Either
              way, nothing about the page ever leaves your computer.
            </p>
          </div>
          <div class="ai-mapping-grid">
            <div class="ai-mapping-copy">
              <h3>Why it's different</h3>
              <div class="feature-list">
                {
                  [
                    "Runs Chrome's on-device model locally — no API key, no server, no data leaves your machine",
                    "Works identically without it: heuristics alone prefill every field",
                    "Edit any field — pin an exact value, or randomize it by type",
                    "Save the finished map as a snapshot and it fills instantly next time, no re-scanning",
                  ].map((item) => (
                    <div class="feature-check-item">
                      <svg
                        aria-hidden="true"
                        focusable="false"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path d="M20 6L9 17l-5-5" />
                      </svg>
                      <span>{item}</span>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="device-mock">
              <div class="device-mock-bar">
                <span class="device-dot red"></span>
                <span class="device-dot yellow"></span>
                <span class="device-dot green"></span>
                <span class="device-mock-url">checkout.example.com</span>
              </div>
              <div class="device-mock-body">
                <div class="ai-status">
                  <span class="ai-status-dot"></span>
                  On-device AI ready
                </div>
                <div class="map-field">
                  <span class="map-field-label">Email address</span>
                  <span class="map-pill random">email · random</span>
                </div>
                <div class="map-field">
                  <span class="map-field-label">Coupon code</span>
                  <span class="map-pill exact">exact · SAVE20</span>
                </div>
                <div class="map-field">
                  <span class="map-field-label">Country</span>
                  <span class="map-pill random">select · random</span>
                </div>
                <div class="map-summary">Filled 3 fields · 0 skipped</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- How it works -->
      <section id="how-it-works" class="section scroll-mt">
        <div class="section-inner">
          <div class="section-head">
            <div class="badge">How it works</div>
            <h2>From install to filled in 60 seconds</h2>
          </div>
          <div class="steps">
            {
              [
                {
                  n: "01",
                  title: "Install in one click",
                  desc: "Add FillMatic from the Chrome Web Store. No account, no sign-up.",
                },
                {
                  n: "02",
                  title: "Open any web form",
                  desc: "Navigate to a registration page, checkout, or any form you test regularly.",
                },
                {
                  n: "03",
                  title: "Fill with one click",
                  desc: "Click the FillMatic icon or press the keyboard shortcut. Every visible field fills in milliseconds.",
                },
              ].map(({ n, title, desc }) => (
                <div class="step">
                  <span class="step-number" aria-hidden="true">
                    {n}
                  </span>
                  <h3>{title}</h3>
                  <p>{desc}</p>
                </div>
              ))
            }
          </div>
          <div class="cta-center">
            <a
              href={STORE_URL}
              target="_blank"
              rel="noopener"
              class="btn btn-primary btn-lg"
            >
              Get FillMatic
              <svg
                aria-hidden="true"
                focusable="false"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
              >
            </a>
          </div>
        </div>
      </section>

      <!-- Everything included -->
      <section class="section section-accent">
        <div class="section-inner">
          <div class="section-head light">
            <h2>Everything included, no paid tier</h2>
            <p>FillMatic is free and always will be.</p>
          </div>
          <div class="checklist">
            {
              [
                "Fills every native input type: text, email, password, select, checkbox, radio, date, and more",
                "Custom widgets from Radix, MUI, and other component libraries work with zero setup",
                "Rich text editors — Notion-style, Lexical, ProseMirror, Quill — fill correctly, not just plain text",
                "Teach it any input it doesn't recognize with a recipe — a CSS selector and a few declarative steps",
                "On-device AI field mapping via Chrome's built-in model, nothing leaves your machine",
                "Works identically without AI — heuristics prefill every field on their own",
                "Keyboard shortcut so you never have to touch the mouse",
                "Handles dynamic forms that mount new fields after page load",
                "Export recipes and field maps as JSON to share with your team",
                "No account required. Works completely offline.",
              ].map((item) => (
                <div class="check-item">
                  <svg
                    aria-hidden="true"
                    focusable="false"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                  <span>{item}</span>
                </div>
              ))
            }
          </div>
          <div class="cta-center">
            <a
              href={STORE_URL}
              target="_blank"
              rel="noopener"
              class="btn btn-light btn-lg">Add to Chrome</a
            >
            <a href="/demo" class="btn btn-ghost-light btn-lg"
              >See it in action</a
            >
          </div>
        </div>
      </section>

      <!-- Payment integrations -->
      <section class="section">
        <div class="section-inner">
          <div class="section-head">
            <div class="badge">Payment integrations</div>
            <h2>Test payment flows without memorizing test cards</h2>
            <p>
              FillMatic ships with built-in Actions for the most common payment
              processors. Click once and the right card fills in. No
              copy-pasting from docs.
            </p>
          </div>
          <div class="card-grid three-col">
            {
              [
                {
                  name: "Stripe",
                  card: "4242 4242 4242 4242",
                  color: "#6366f1",
                },
                {
                  name: "Lemon Squeezy",
                  card: "4242 4242 4242 4242",
                  color: "#d97706",
                },
                {
                  name: "Paddle",
                  card: "4000 0566 5566 5556",
                  color: "#2563eb",
                },
              ].map(({ name, card, color }) => (
                <div class="glass-card payment-card">
                  <span
                    class="payment-badge"
                    style={`color: ${color}; border-color: ${color}33; background: ${color}11`}
                  >
                    {name}
                  </span>
                  <svg
                    aria-hidden="true"
                    focusable="false"
                    class="payment-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <>
                      <rect x="1" y="4" width="22" height="16" rx="2" />
                      <line x1="1" y1="10" x2="23" y2="10" />
                    </>
                  </svg>
                  <p class="payment-num">{card}</p>
                  <p class="payment-sub">Filled automatically on checkout</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Feedback -->
      <section id="feedback" class="section section-tinted scroll-mt">
        <div class="section-inner narrow">
          <div class="section-head">
            <h2>Share your feedback</h2>
            <p>
              Got an idea or something that's not working? I read every message.
            </p>
          </div>
          <div class="glass-card feedback-card">
            <form
              action={`https://airform.io/${SUPPORT_EMAIL}`}
              method="POST"
              class="feedback-form"
              aria-describedby="feedback-privacy-note"
            >
              <div class="field-row">
                <div class="field">
                  <label for="fb-name">Name</label>
                  <input
                    type="text"
                    id="fb-name"
                    name="Name"
                    placeholder="Your name"
                    autocomplete="name"
                    required
                  />
                </div>
                <div class="field">
                  <label for="fb-email">Email</label>
                  <input
                    type="email"
                    id="fb-email"
                    name="Email"
                    placeholder="you@example.com"
                    autocomplete="email"
                    required
                  />
                </div>
              </div>
              <div class="field">
                <label for="fb-msg">Message</label>
                <textarea
                  id="fb-msg"
                  name="Feedback"
                  placeholder="What would you like to see improved?"
                  rows="4"
                  required></textarea>
              </div>
              <button type="submit" class="btn btn-primary btn-lg w-full"
                >Send feedback</button
              >
            </form>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <img src="icon192.png" alt="FillMatic" width="18" height="18" />
          <span
            >© 2026 Fill<span class="logo-em">Matic</span>. All rights reserved.</span
          >
        </div>
        <nav class="footer-nav" aria-label="Footer">
          <a href="/demo">Demo</a>
          <a href="/privacy">Privacy</a>
          <a href={STORE_URL} target="_blank" rel="noopener">Chrome Web Store</a
          >
        </nav>
      </div>
    </footer>
  </div>
</Layout>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* ── Skip link ── */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 9999;
    padding: 0.6rem 1.2rem;
    background: #4f46e5;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 0 0 8px 8px;
    text-decoration: none;
    transition: top 0.15s;
  }

  .skip-link:focus {
    top: 0;
  }

  /* ── Focus ring ── */
  :focus-visible {
    outline: 2px solid #818cf8;
