---
import Layout from '../layouts/Layout.astro'
import { PRODUCT_NAME, SUPPORT_EMAIL } from '@fillmatic/config'
---

<Layout title={`Demo — ${PRODUCT_NAME}`}>
  <div class="page-bg">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-badge">Interactive Demo</div>
      <h1>Try it out</h1>
      <p class="hero-sub">
        Open FillMatic and hit <strong>Fill all fields</strong> to fill everything at once. Named forms show up as their own
        buttons in the popup so you can fill and submit just that one.
      </p>
    </section>

    <!-- Top two forms -->
    <section class="forms-grid">
      <!-- Form 1: Signup -->
      <div class="form-card">
        <div class="form-card-header">
          <h2>Create account</h2>
        </div>
        <form name="Signup" id="signup-form" class="glass-form" novalidate>
          <div class="field-row">
            <div class="field">
              <label for="signup-first">First name</label>
              <input type="text" id="signup-first" name="first_name" placeholder="Jane" autocomplete="given-name" />
            </div>
            <div class="field">
              <label for="signup-last">Last name</label>
              <input type="text" id="signup-last" name="last_name" placeholder="Smith" autocomplete="family-name" />
            </div>
          </div>
          <div class="field">
            <label for="signup-username">Username</label>
            <input type="text" id="signup-username" name="username" placeholder="janesmith" autocomplete="username" />
          </div>
          <div class="field">
            <label for="signup-email">Email address</label>
            <input type="email" id="signup-email" name="email" placeholder="jane@example.com" autocomplete="email" />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="signup-password">Password</label>
              <input
                type="password"
                id="signup-password"
                name="password"
                placeholder="••••••••"
                autocomplete="new-password"
                minlength="8"
              />
            </div>
            <div class="field">
              <label for="signup-confirm">Confirm password</label>
              <input
                type="password"
                id="signup-confirm"
                name="confirm_password"
                placeholder="••••••••"
                autocomplete="new-password"
                minlength="8"
              />
            </div>
          </div>
          <div class="field">
            <label for="signup-phone">Phone number</label>
            <input type="tel" id="signup-phone" name="phone" placeholder="+1 555 000 0000" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="signup-dob">Date of birth</label>
            <input type="date" id="signup-dob" name="date_of_birth" autocomplete="bday" />
          </div>
          <div class="field checkbox-field">
            <input type="checkbox" id="signup-terms" name="terms" />
            <label for="signup-terms">I agree to the <a href="#">Terms &amp; Conditions</a></label>
          </div>
          <button type="submit" class="submit-btn">Create account</button>
        </form>
        <div class="form-success" id="signup-success" hidden>
          <div class="success-icon">✓</div>
          <h3>Account created!</h3>
          <p>FillMatic filled and submitted this form instantly.</p>
          <button class="reset-btn" data-target="signup-form" data-success="signup-success">Try again</button>
        </div>
      </div>

      <!-- Form 2: Checkout -->
      <div class="form-card">
        <div class="form-card-header">
          <h2>Complete purchase</h2>
        </div>
        <form name="Checkout" id="checkout-form" class="glass-form" novalidate>
          <div class="field-row">
            <div class="field">
              <label for="checkout-first">First name</label>
              <input type="text" id="checkout-first" name="first_name" placeholder="Jane" autocomplete="given-name" />
            </div>
            <div class="field">
              <label for="checkout-last">Last name</label>
              <input type="text" id="checkout-last" name="last_name" placeholder="Smith" autocomplete="family-name" />
            </div>
          </div>
          <div class="field">
            <label for="checkout-email">Email</label>
            <input type="email" id="checkout-email" name="email" placeholder="jane@example.com" autocomplete="email" />
          </div>
          <div class="field">
            <label for="checkout-address">Street address</label>
            <input
              type="text"
              id="checkout-address"
              name="address"
              placeholder="123 Main St"
              autocomplete="street-address"
            />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="checkout-city">City</label>
              <input
                type="text"
                id="checkout-city"
                name="city"
                placeholder="San Francisco"
                autocomplete="address-level2"
              />
            </div>
            <div class="field">
              <label for="checkout-zip">ZIP / Postal</label>
              <input
                type="text"
                id="checkout-zip"
                name="postal_code"
                placeholder="94103"
                autocomplete="postal-code"
                maxlength="10"
              />
            </div>
          </div>
          <div class="field">
            <label for="checkout-country">Country</label>
            <select id="checkout-country" name="country" autocomplete="country">
              <option value="">Select country…</option>
              <option value="US">United States</option>
              <option value="GB">United Kingdom</option>
              <option value="CA">Canada</option>
              <option value="AU">Australia</option>
              <option value="DE">Germany</option>
              <option value="FR">France</option>
              <option value="IN">India</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="section-label">Payment</div>
          <div class="field">
            <label for="checkout-card-name">Name on card</label>
            <input
              type="text"
              id="checkout-card-name"
              name="card_name"
              placeholder="Jane Smith"
              autocomplete="cc-name"
            />
          </div>
          <div class="field">
            <label for="checkout-card-number">Card number</label>
            <input
              type="text"
              id="checkout-card-number"
              name="card_number"
              placeholder="4242 4242 4242 4242"
              autocomplete="cc-number"
              maxlength="19"
            />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="checkout-expiry">Expiry (MM/YY)</label>
              <input
                type="text"
                id="checkout-expiry"
                name="cc_exp"
                placeholder="MM/YY"
                autocomplete="cc-exp"
                maxlength="5"
              />
            </div>
            <div class="field">
              <label for="checkout-cvv">CVV</label>
              <input type="text" id="checkout-cvv" name="cvv" placeholder="123" autocomplete="cc-csc" maxlength="4" />
            </div>
          </div>
          <button type="submit" class="submit-btn">Pay now</button>
        </form>
        <div class="form-success" id="checkout-success" hidden>
          <div class="success-icon">✓</div>
          <h3>Order placed!</h3>
          <p>FillMatic filled and submitted this form instantly.</p>
          <button class="reset-btn" data-target="checkout-form" data-success="checkout-success">Try again</button>
        </div>
      </div>
    </section>

    <!-- Full-width kitchen sink form -->
    <!-- name="text" is included so the "Fill Demo Form" action in the FillMatic popup overrides that field with special demo data -->
    <section class="forms-grid full-width-grid">
      <div class="form-card">
        <div class="form-card-header">
          <h2>All input types</h2>
        </div>
        <form name="All inputs" id="allinputs-form" class="glass-form kitchen-sink" novalidate>
          <div class="section-label">Text inputs</div>
          <div class="field-row three-col">
            <div class="field">
              <label for="k-text">Text</label>
              <input type="text" id="k-text" name="text" placeholder="Plain text" minlength="1" maxlength="100" />
            </div>
            <div class="field">
              <label for="k-search">Search</label>
              <input type="search" id="k-search" name="search" placeholder="Search…" />
            </div>
            <div class="field">
              <label for="k-url">URL</label>
              <input type="url" id="k-url" name="url" placeholder="https://example.com" />
            </div>
          </div>
          <div class="field-row three-col">
            <div class="field">
              <label for="k-email">Email</label>
              <input type="email" id="k-email" name="email" placeholder="you@example.com" autocomplete="email" />
            </div>
            <div class="field">
              <label for="k-tel">Phone</label>
              <input type="tel" id="k-tel" name="phone" placeholder="+1 555 000 0000" autocomplete="tel" />
            </div>
            <div class="field">
              <label for="k-number">Number</label>
              <input type="number" id="k-number" name="number" placeholder="42" min="0" max="1000" />
            </div>
          </div>

          <div class="field">
            <label for="k-textarea">Message</label>
            <textarea id="k-textarea" name="message" placeholder="Write something…" rows="3"></textarea>
          </div>
          <div class="field">
            <label for="k-demo-note">Demo action note</label>
            <textarea
              id="k-demo-note"
              name="demo_note"
              placeholder="Click 'Fill Demo Form' in the FillMatic popup to see this filled with custom text from the action…"
              rows="4"></textarea>
          </div>

          <div class="section-label">Date &amp; time</div>
          <div class="field-row three-col">
            <div class="field">
              <label for="k-date">Date</label>
              <input type="date" id="k-date" name="date" min="2000-01-01" max="2030-12-31" />
            </div>
            <div class="field">
              <label for="k-time">Time</label>
              <input type="time" id="k-time" name="time" min="00:00" max="23:59" />
            </div>
            <div class="field">
              <label for="k-datetime">Date &amp; time</label>
              <input
                type="datetime-local"
                id="k-datetime"
                name="datetime"
                min="2000-01-01T00:00"
                max="2030-12-31T23:59"
              />
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="k-month">Month</label>
              <input type="month" id="k-month" name="month" min="2000-01" max="2030-12" />
            </div>
            <div class="field">
              <label for="k-week">Week</label>
              <input type="week" id="k-week" name="week" min="2000-W01" max="2030-W52" />
            </div>
          </div>

          <div class="section-label">Pickers &amp; controls</div>
          <div class="field-row three-col">
            <div class="field">
              <label for="k-color">Color</label>
              <input type="color" id="k-color" name="color" class="color-input" />
            </div>
            <div class="field">
              <label for="k-range">Range <span id="range-val">50</span></label>
              <input type="range" id="k-range" name="range" min="0" max="100" value="50" class="range-input" />
            </div>
            <div class="field">
              <label for="k-select">Preference</label>
              <select id="k-select" name="preference">
                <option value="">Choose…</option>
                <option value="option1">Option 1</option>
                <option value="option2">Option 2</option>
                <option value="option3">Option 3</option>
              </select>
            </div>
          </div>

          <div class="section-label">Choices</div>
          <div class="field-row">
            <div class="field">
              <span class="field-label">Subscription</span>
              <div class="radio-group">
                <label class="radio-label">
                  <input type="radio" name="plan" value="free" /> Free
                </label>
                <label class="radio-label">
                  <input type="radio" name="plan" value="pro" /> Pro
                </label>
                <label class="radio-label">
                  <input type="radio" name="plan" value="team" /> Team
                </label>
              </div>
            </div>
            <div class="field">
              <span class="field-label">Notifications</span>
              <div class="checkbox-group">
                <label class="radio-label">
                  <input type="checkbox" name="notify_email" /> Email
                </label>
                <label class="radio-label">
                  <input type="checkbox" name="notify_sms" /> SMS
                </label>
                <label class="radio-label">
                  <input type="checkbox" name="notify_push" /> Push
                </label>
              </div>
            </div>
          </div>

          <div class="section-label">Security</div>
          <div class="field-row">
            <div class="field">
              <label for="k-password">Password</label>
              <input type="password" id="k-password" name="password" placeholder="••••••••" minlength="8" />
            </div>
            <div class="field">
              <label for="k-confirm">Confirm password</label>
              <input type="password" id="k-confirm" name="confirm_password" placeholder="••••••••" minlength="8" />
            </div>
          </div>

          <button type="submit" class="submit-btn">Submit</button>
        </form>
        <div class="form-success" id="allinputs-success" hidden>
          <div class="success-icon">✓</div>
          <h3>All done!</h3>
          <p>Every input type filled successfully.</p>
          <button class="reset-btn" data-target="allinputs-form" data-success="allinputs-success">Try again</button>
        </div>
      </div>
    </section>

    <!-- Custom ARIA widgets (no native inputs) — exercises FillMatic's widget fill strategy -->
    <section class="forms-grid full-width-grid">
      <div class="form-card">
        <div class="form-card-header">
          <h2>Custom widgets</h2>
        </div>
        <div class="glass-form kitchen-sink" id="widgets-panel">
          <p class="widgets-note">
            These controls are built from plain <code>div</code>s and <code>button</code>s with ARIA roles — the way
            component libraries like Radix, MUI or Headless UI render them. No native inputs involved.
          </p>

          <div class="field-row">
            <div class="field">
              <span class="field-label" id="w-fruit-label">Favorite fruit</span>
              <button
                type="button"
                class="widget-trigger"
                id="w-fruit"
                role="combobox"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="w-fruit-listbox"
                aria-labelledby="w-fruit-label"
                data-placeholder="Select a fruit…">Select a fruit…</button
              >
              <div class="widget-listbox" id="w-fruit-listbox" role="listbox" aria-labelledby="w-fruit-label" hidden>
                <div class="widget-option" role="option" aria-selected="false">Apple</div>
                <div class="widget-option" role="option" aria-selected="false">Banana</div>
                <div class="widget-option" role="option" aria-selected="false">Cherry</div>
                <div class="widget-option" role="option" aria-selected="false">Dragonfruit</div>
              </div>
            </div>
            <div class="field">
              <span class="field-label" id="w-date-label">Delivery date</span>
              <button
                type="button"
                class="widget-trigger"
                id="w-date"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="w-date-dialog"
                aria-labelledby="w-date-label"
                data-placeholder="Pick a date…">Pick a date…</button
              >
              <div class="widget-dialog" id="w-date-dialog" role="dialog" aria-label="Choose date" hidden>
                <div class="widget-grid" role="grid" aria-label="Days"></div>
              </div>
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <span class="field-label" id="w-news-label">Newsletter</span>
              <button
                type="button"
                class="widget-switch"
                id="w-newsletter"
                role="switch"
                aria-checked="false"
                aria-labelledby="w-news-label"><span class="widget-switch-thumb"></span></button
              >
            </div>
            <div class="field">
              <span class="field-label" id="w-size-label">T-shirt size</span>
              <div class="widget-radiogroup" role="radiogroup" aria-labelledby="w-size-label" id="w-size">
                <div class="widget-radio" role="radio" aria-checked="false" tabindex="0">Small</div>
                <div class="widget-radio" role="radio" aria-checked="false" tabindex="0">Medium</div>
                <div class="widget-radio" role="radio" aria-checked="false" tabindex="0">Large</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contenteditable hosts — exercises FillMatic's editor-aware contenteditable strategy -->
    <section class="forms-grid full-width-grid">
      <div class="form-card">
        <div class="form-card-header">
          <h2>Rich text &amp; editable areas</h2>
        </div>
        <div class="glass-form kitchen-sink" id="editable-panel">
          <p class="widgets-note">
            Editable <code>div</code>s the way rich-text editors render them — a plain
            <code>contenteditable</code> host, a <code>plaintext-only</code> host, and a fake ProseMirror-style editor that
            only accepts text through <code>beforeinput</code>.
          </p>

          <div class="field-row">
            <div class="field">
              <span class="field-label" id="ce-notes-label">Notes (contenteditable)</span>
              <div class="editable-host" contenteditable="true" role="textbox" aria-labelledby="ce-notes-label"></div>
            </div>
            <div class="field">
              <span class="field-label" id="ce-plain-label">Comment (plaintext-only)</span>
              <div
                class="editable-host"
                contenteditable="plaintext-only"
                role="textbox"
                aria-labelledby="ce-plain-label"
              >
              </div>
            </div>
          </div>

          <div class="field">
            <span class="field-label" id="ce-editor-label">Bio (model-backed editor)</span>
            <div
              class="editable-host editable-tall ProseMirror"
              id="ce-editor"
              contenteditable="true"
              role="textbox"
              aria-labelledby="ce-editor-label"
            >
            </div>
            <p class="widgets-note" id="ce-editor-state">Editor model: (empty)</p>
          </div>
        </div>
      </div>
    </section>

    <footer class="demo-footer">
      Nothing here is real — all values are dummy data. ·
      <a href={`mailto:${SUPPORT_EMAIL}?subject=${PRODUCT_NAME} Feedback`}>Send feedback</a>
    </footer>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLFormElement>('.glass-form').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault()
      const successId = form.id.replace('-form', '-success')
      form.hidden = true
      const success = document.getElementById(successId)
      if (success) success.hidden = false
    })
  })

  document.querySelectorAll<HTMLButtonElement>('.reset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const formEl = document.getElementById(btn.dataset.target!) as HTMLFormElement
      const successEl = document.getElementById(btn.dataset.success!)
      if (formEl) {
        formEl.reset()
        formEl.hidden = false
      }
      if (successEl) successEl.hidden = true
    })
  })

  const rangeEl = document.getElementById('k-range') as HTMLInputElement
  const rangeVal = document.getElementById('range-val')
  if (rangeEl && rangeVal) {
    rangeEl.addEventListener('input', () => {
      rangeVal.textContent = rangeEl.value
    })
  }

  /* --- Custom ARIA widgets (combobox, date dialog, switch, radiogroup) --- */

  const setupPopoverTrigger = (trigger: HTMLButtonElement, popover: HTMLElement) => {
    const close = () => {
      popover.hidden = true
      trigger.setAttribute('aria-expanded', 'false')
    }
    trigger.addEventListener('click', () => {
      const opening = popover.hidden
      popover.hidden = !opening
      trigger.setAttribute('aria-expanded', String(opening))
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close()
    })
    return close
  }

  const fruitTrigger = document.getElementById('w-fruit') as HTMLButtonElement
  const fruitListbox = document.getElementById('w-fruit-listbox')!
  if (fruitTrigger && fruitListbox) {
    const close = setupPopoverTrigger(fruitTrigger, fruitListbox)
    fruitListbox.querySelectorAll<HTMLElement>('[role="option"]').forEach((option) => {
      option.addEventListener('click', () => {
        fruitListbox.querySelectorAll('[role="option"]').forEach((o) => o.setAttribute('aria-selected', 'false'))
        option.setAttribute('aria-selected', 'true')
        fruitTrigger.textContent = option.textContent
        close()
      })
    })
  }

  const dateTrigger = document.getElementById('w-date') as HTMLButtonElement
  const dateDialog = document.getElementById('w-date-dialog')!
  const dateGrid = dateDialog?.querySelector('[role="grid"]')
  if (dateTrigger && dateDialog && dateGrid) {
    const close = setupPopoverTrigger(dateTrigger, dateDialog)
    const now = new Date()
    const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate()
    for (let day = 1; day <= daysInMonth; day++) {
      const cell = document.createElement('button')
      cell.type = 'button'
      cell.setAttribute('role', 'gridcell')
      cell.className = 'widget-day'
      cell.textContent = String(day)
      cell.addEventListener('click', () => {
        const picked = new Date(now.getFullYear(), now.getMonth(), day)
        dateTrigger.textContent = picked.toLocaleDateString()
        close()
      })
      dateGrid.appendChild(cell)
    }
  }

  const newsletterSwitch = document.getElementById('w-newsletter')
  newsletterSwitch?.addEventListener('click', () => {
    const checked = newsletterSwitch.getAttribute('aria-checked') === 'true'
    newsletterSwitch.setAttribute('aria-checked', String(!checked))
  })

  document.querySelectorAll<HTMLElement>("#w-size [role='radio']").forEach((radio) => {
    radio.addEventListener('click', () => {
      radio
        .closest("[role='radiogroup']")
        ?.querySelectorAll("[role='radio']")
        .forEach((r) => r.setAttribute('aria-checked', 'false'))
      radio.setAttribute('aria-checked', 'true')
    })
  })

  /* --- Model-backed editor: only accepts text through beforeinput (like ProseMirror/Lexical) --- */

  const modelEditor = document.getElementById('ce-editor')
  const modelState = document.getElementById('ce-editor-state')
  if (modelEditor && modelState) {
    let model = ''
    const render = () => {
      modelEditor.textContent = model
      modelState.textContent = `Editor model: ${model ? `"${model}"` : '(empty)'}`
    }
    modelEditor.addEventListener('beforeinput', (e) => {
      e.preventDefault() // the editor owns all mutations
      const ev = e as InputEvent
      if (ev.inputType === 'insertText' && ev.data) model += ev.data
      if (ev.inputType === 'deleteContentBackward') model = model.slice(0, -1)
      render()
    })
  }
</script>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  .page-bg {
    min-height: 100vh;
    background:
      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(99, 102, 241, 0.18) 0%, transparent 70%),
      linear-gradient(160deg, #0f0f18 0%, #141420 45%, #0d1117 100%);
    padding: 3rem 1.5rem 4rem;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    color: #e2e8f0;
  }

  a {
    color: #818cf8;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }

  code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.8em;
    background: rgba(255, 255, 255, 0.08);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    color: #a5b4fc;
  }

  /* Hero */
  .hero {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 2.5rem;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #818cf8;
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 999px;
    padding: 0.3em 0.9em;
    margin-bottom: 1.25rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    background: linear-gradient(135deg, #e2e8f0 30%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
